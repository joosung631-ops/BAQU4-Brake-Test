<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_transport</transport_id>
        <type>SHM</type>
        <!--
          camera 패키지와 같은 문제(docs/2026-08-21.md 1번 항목): 기본 SHM
          세그먼트 크기가 PointCloud2 메시지보다 작아서 SHM을 못 타고 UDP로
          샌다. 실측 메시지 크기가 1.57MB(LEGACY, 1024x10, 32ch)였고, 더
          높은 해상도(lidar_mode 최대 4096x5)로 바꿔도 넉넉하도록 16MB로 잡음.
        -->
        <segment_size>16777216</segment_size>
        <port_queue_capacity>50</port_queue_capacity>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="shm_participant" is_default_profile="true">
      <rtps>
        <!-- UDP는 그대로 두고 SHM을 추가 선택지로만 더한다 (같은 호스트일 때만 자동 사용됨) -->
        <userTransports>
          <transport_id>shm_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>true</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
